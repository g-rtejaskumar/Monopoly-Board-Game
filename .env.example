# BoardQuest environment variables
# Copy this file to .env.local (never commit real .env files) and fill in values.
#
# ── Frontend (Vite — baked in at BUILD time, safe to expose: they carry no secrets) ──
# WebSocket endpoint of the BoardQuest realtime game server.
#   Local dev:       leave unset (defaults to the Vite proxy on ws://localhost:8787)
#   Production:      wss://your-game-server.example.com   (set in Vercel → Settings → Environment Variables)
# VITE_WS_URL=wss://your-game-server.example.com
#
# ── Backend (game server process — NOT exposed to the browser) ──────────────────────
# Port the WebSocket server listens on (defaults to 8787).
# PORT=8787
