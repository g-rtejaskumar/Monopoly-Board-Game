# ==========================================
# BoardQuest environment configuration
# ==========================================
#
# VITE_WS_URL — used by the FRONTEND (browser client).
#   * It is a BUILD-TIME Vite variable: the value is baked into the JavaScript
#     bundle when `npm run build` runs. Changing it requires a new deploy.
#   * Local development uses the local WebSocket server (below).
#   * In production (Vercel) it MUST use wss:// (TLS) and MUST include /ws:
#       VITE_WS_URL=wss://YOUR-RENDER-SERVICE.onrender.com/ws
#
# Frontend WebSocket endpoint.
# For local development, use the local WebSocket server:
VITE_WS_URL=ws://localhost:8787/ws

# For production, replace the value in Vercel with:
# VITE_WS_URL=wss://YOUR-RENDER-SERVICE.onrender.com/ws
#
# PORT — used by the BACKEND (server/index.ts).
#   * Render normally injects PORT automatically — do not set it there.
#   * This value is mainly for local development.
PORT=8787

# NOTE: This is an example file only — no secrets belong in VITE_* variables
# (they are public by design) and real credentials must never be committed.
