# BoardQuest environment variables
# Copy to .env.local for local use. NEVER commit real .env files.

# ── Frontend (Vercel / Vite) ─────────────────────────────────────────────────
# WebSocket endpoint of the BoardQuest realtime game server.
# This is a FRONTEND BUILD-TIME variable: it is baked into the bundle by Vite.
# Changing it REQUIRES A NEW VERCEL DEPLOYMENT (no redeploy = no effect).
#
#   Local dev:      leave unset — the Vite dev proxy forwards to ws://localhost:8787
#   Production:     wss://your-render-service.onrender.com/ws
#
# Rules:
#   - Must start with ws:// or wss:// (http:// and https:// are rejected)
#   - Use wss:// in production (browsers block ws:// from https:// pages)
#   - VITE_* variables are public by design — never put secrets here
#
# VITE_WS_URL=wss://your-render-service.onrender.com/ws

# ── Backend (Render / Node game server process) ─────────────────────────────
# Port the WebSocket server listens on.
# Render injects PORT automatically — do not hardcode it there.
# Locally it defaults to 8787 when unset.
#
# PORT=8787
